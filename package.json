{
  "name": "virtual-world",
  "version": "0.1.0",
  "description": "Browser track editor for NeuroRacer, with live checks ported from its trainer",
  "license": "MIT",
  "homepage": "https://neuroracer-editor.pages.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/ethanstoner/virtual-world.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5174",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
